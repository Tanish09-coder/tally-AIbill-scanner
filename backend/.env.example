# ==========================================
# AI Bill Scanner & TallyPrime Automation
# Environment Configuration
# ==========================================

# 1. AI Engine - Google Gemini API Key
# Required for Vision OCR, Multilingual (Hindi, Marathi, English) Handwriting & Invoice Extraction
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Voice Assistant - Sarvam AI API Key
# Required for natural conversational Indian Hinglish Speech-to-Text & Text-to-Speech
SARVAM_API_KEY=your_sarvam_api_key_here

# 3. TallyPrime XML over HTTP Server Configuration
# Ensure TallyPrime has ODBC / HTTP Server enabled under F12 > Advanced Configuration
TALLY_HOST=http://localhost
TALLY_PORT=9000

# 4. Database & Storage Configuration
DATABASE_URL=sqlite+aiosqlite:///./app.db
UPLOAD_DIR=./uploads

# 5. Application Security & Server Settings
SECRET_KEY=generate_a_secure_random_key_for_jwt_and_session
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

